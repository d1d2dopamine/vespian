<?xml version="1.0" encoding="utf-8"?>
<!-- Per-app language picker. SettingsActivity calls
     AppCompatDelegate.setApplicationLocales; without this file the system
     picker never lists the app. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ru" />
</locale-config>
